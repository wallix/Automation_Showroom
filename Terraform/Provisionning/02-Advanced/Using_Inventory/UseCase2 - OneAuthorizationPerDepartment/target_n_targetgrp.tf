resource "wallix-bastion_device" "vms" {
  for_each = local.vms

  device_name = each.value.name
  host        = each.value.ip
}

resource "wallix-bastion_device_service" "vms" {
  for_each = local.vms

  device_id         = wallix-bastion_device.vms[each.key].id
  service_name      = each.value.service
  protocol          = each.value.service
  connection_policy = each.value.service
  port              = each.value.port
  subprotocols      = local.subprotocols[each.value.service]
}

# Local domain: accounts that only exist on their device.
resource "wallix-bastion_device_localdomain" "vms" {
  for_each = wallix-bastion_device.vms

  device_id   = each.value.id
  domain_name = "local"
}

# One shared account per device (root, administrator).
resource "wallix-bastion_device_localdomain_account" "vms" {
  for_each = local.vms

  device_id     = wallix-bastion_device.vms[each.key].id
  domain_id     = wallix-bastion_device_localdomain.vms[each.key].id
  account_name  = each.value.account
  account_login = each.value.account
  services      = [wallix-bastion_device_service.vms[each.key].service_name]
}

# SSH accounts: key pair generated by the Bastion. RDP accounts: password.
resource "wallix-bastion_device_localdomain_account_credential" "ssh_key" {
  for_each = { for k, vm in local.vms : k => vm if vm.service == "SSH" }

  device_id   = wallix-bastion_device.vms[each.key].id
  domain_id   = wallix-bastion_device_localdomain.vms[each.key].id
  account_id  = wallix-bastion_device_localdomain_account.vms[each.key].id
  type        = "ssh_key"
  private_key = "generate:ED25519"
}

resource "wallix-bastion_device_localdomain_account_credential" "password" {
  for_each = random_password.accounts

  device_id  = wallix-bastion_device.vms[each.key].id
  domain_id  = wallix-bastion_device_localdomain.vms[each.key].id
  account_id = wallix-bastion_device_localdomain_account.vms[each.key].id
  type       = "password"
  password   = each.value.result
}

# One target group per department: the shared account of each of its servers.
resource "wallix-bastion_targetgroup" "departments" {
  for_each = local.inventory.target_group_inventory

  group_name = each.key

  dynamic "session_accounts" {
    for_each = toset(each.value)
    content {
      account     = wallix-bastion_device_localdomain_account.vms[session_accounts.key].account_name
      domain      = wallix-bastion_device_localdomain.vms[session_accounts.key].domain_name
      domain_type = "local"
      device      = wallix-bastion_device.vms[session_accounts.key].device_name
      service     = wallix-bastion_device_service.vms[session_accounts.key].service_name
    }
  }
}
