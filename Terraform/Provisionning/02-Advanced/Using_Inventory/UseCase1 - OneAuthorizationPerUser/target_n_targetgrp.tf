resource "wallix-bastion_device" "vms" {
  for_each = local.vms

  device_name = each.value.name
  host        = each.value.ip
}

resource "wallix-bastion_device_service" "vms" {
  for_each = local.vms

  device_id         = wallix-bastion_device.vms[each.key].id
  service_name      = each.value.service
  protocol          = each.value.service
  connection_policy = each.value.service
  port              = each.value.port
  subprotocols      = local.subprotocols[each.value.service]
  global_domains    = [wallix-bastion_domain.demo.domain_name]
}

# Global domain: one account per user, usable on every VM listed in the user's targets.
resource "wallix-bastion_domain" "demo" {
  domain_name = var.domain_name
}

resource "wallix-bastion_domain_account" "users" {
  for_each = wallix-bastion_user.users

  domain_id     = wallix-bastion_domain.demo.id
  account_name  = each.value.user_name
  account_login = each.value.user_name
  # <device>:<service> of each VM in the user's targets, and <application>:APP of their applications.
  # The applications must be listed: the target group attaches them, and an unlisted one shows as a change.
  resources = concat(
    [for vm in local.users[each.key].targets : "${wallix-bastion_device.vms[vm].device_name}:${wallix-bastion_device_service.vms[vm].service_name}"],
    [for vm in local.users[each.key].targets : "${wallix-bastion_application.apps[vm].application_name}:APP" if contains(keys(local.app_vms), vm)],
  )
}

# Each account gets a password (RDP) and an SSH key generated by the Bastion (SSH).
resource "wallix-bastion_domain_account_credential" "password" {
  for_each = wallix-bastion_domain_account.users

  domain_id  = each.value.domain_id
  account_id = each.value.id
  type       = "password"
  password   = random_password.accounts[each.key].result
}

resource "wallix-bastion_domain_account_credential" "ssh_key" {
  for_each = wallix-bastion_domain_account.users

  domain_id   = each.value.domain_id
  account_id  = each.value.id
  type        = "ssh_key"
  private_key = "generate:ED25519"
}

# One target group per user: the user's account on each of the user's targets, plus the user's applications.
resource "wallix-bastion_targetgroup" "users" {
  for_each = wallix-bastion_domain_account.users

  group_name = each.value.account_name

  dynamic "session_accounts" {
    for_each = toset(local.users[each.key].targets)
    content {
      account     = each.value.account_name
      domain      = wallix-bastion_domain.demo.domain_name
      domain_type = "global"
      device      = wallix-bastion_device.vms[session_accounts.key].device_name
      service     = wallix-bastion_device_service.vms[session_accounts.key].service_name
    }
  }

  dynamic "session_accounts" {
    for_each = toset([for vm in local.users[each.key].targets : vm if contains(keys(local.app_vms), vm)])
    content {
      account     = each.value.account_name
      domain      = wallix-bastion_domain.demo.domain_name
      domain_type = "global"
      application = wallix-bastion_application.apps[session_accounts.key].application_name
    }
  }
}
