resource "wallix-bastion_device" "vms" {
  for_each = local.vms

  device_name = each.value.name
  host        = each.value.ip
}

resource "wallix-bastion_device_service" "vms" {
  for_each = local.vms

  device_id         = wallix-bastion_device.vms[each.key].id
  service_name      = each.value.service
  protocol          = each.value.service
  connection_policy = each.value.service
  port              = each.value.port
  subprotocols      = local.subprotocols[each.value.service]
}

# Local domain: accounts that only exist on their device.
resource "wallix-bastion_device_localdomain" "vms" {
  for_each = wallix-bastion_device.vms

  device_id   = each.value.id
  domain_name = "local"
}

resource "wallix-bastion_device_localdomain_account" "accounts" {
  for_each = local.vm_accounts

  device_id     = wallix-bastion_device.vms[each.value.vm].id
  domain_id     = wallix-bastion_device_localdomain.vms[each.value.vm].id
  account_name  = each.value.account
  account_login = each.value.account
  services      = [wallix-bastion_device_service.vms[each.value.vm].service_name]
}

# SSH accounts: key pair generated by the Bastion. RDP accounts: password.
resource "wallix-bastion_device_localdomain_account_credential" "ssh_key" {
  for_each = { for k, a in local.vm_accounts : k => a if local.vms[a.vm].service == "SSH" }

  device_id   = wallix-bastion_device.vms[each.value.vm].id
  domain_id   = wallix-bastion_device_localdomain.vms[each.value.vm].id
  account_id  = wallix-bastion_device_localdomain_account.accounts[each.key].id
  type        = "ssh_key"
  private_key = "generate:ED25519"
}

resource "wallix-bastion_device_localdomain_account_credential" "password" {
  for_each = random_password.accounts

  device_id  = wallix-bastion_device.vms[local.vm_accounts[each.key].vm].id
  domain_id  = wallix-bastion_device_localdomain.vms[local.vm_accounts[each.key].vm].id
  account_id = wallix-bastion_device_localdomain_account.accounts[each.key].id
  type       = "password"
  password   = each.value.result
}

# One target group per account of each server, named "<server name>_<account>".
resource "wallix-bastion_targetgroup" "accounts" {
  for_each = local.vm_accounts

  group_name = each.key

  session_accounts {
    account     = wallix-bastion_device_localdomain_account.accounts[each.key].account_name
    domain      = wallix-bastion_device_localdomain.vms[each.value.vm].domain_name
    domain_type = "local"
    device      = wallix-bastion_device.vms[each.value.vm].device_name
    service     = wallix-bastion_device_service.vms[each.value.vm].service_name
  }
}
