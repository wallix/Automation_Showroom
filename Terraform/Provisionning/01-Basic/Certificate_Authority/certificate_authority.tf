# Demo CAs generated by Terraform. With a real PKI, pass the CA public key or certificate (file(...)) instead.
resource "tls_private_key" "ssh_ca" {
  algorithm = "ED25519"
}

resource "tls_private_key" "x509_ca" {
  algorithm   = "ECDSA"
  ecdsa_curve = "P256"
}

resource "tls_self_signed_cert" "x509_ca" {
  private_key_pem       = tls_private_key.x509_ca.private_key_pem
  is_ca_certificate     = true
  validity_period_hours = 24 * 365
  allowed_uses          = ["cert_signing", "crl_signing"]

  subject {
    common_name  = "${local.name} demo CA"
    organization = "Example"
  }
}

# SSH CA: the Bastion gets its public key only.
resource "wallix-bastion_certificate_authority" "ssh" {
  certificate_authority_name = "${local.name}-ssh"
  ca_type                    = "SSH"
  ca_certificate             = tls_private_key.ssh_ca.public_key_openssh
  description                = "Automation Showroom: SSH certificate authority"
}

# X.509 CA: certificate in PEM format (API v3.12).
resource "wallix-bastion_certificate_authority" "x509" {
  certificate_authority_name = "${local.name}-x509"
  ca_type                    = "X509"
  ca_certificate             = tls_self_signed_cert.x509_ca.cert_pem
  description                = "Automation Showroom: X.509 certificate authority"
}
