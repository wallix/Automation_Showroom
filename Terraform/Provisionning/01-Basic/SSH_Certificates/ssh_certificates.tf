# The domain is the signing authority: the Bastion generates its CA key and keeps it.
resource "wallix-bastion_domain" "ssh_ca" {
  domain_name    = "${local.name}.lab"
  description    = "Automation Showroom: SSH certificates"
  ca_private_key = "generate:ED25519"
}

resource "wallix-bastion_domain_account" "admin" {
  domain_id     = wallix-bastion_domain.ssh_ca.id
  account_name  = var.target_account_login
  account_login = var.target_account_login
  resources     = ["${wallix-bastion_device.server.device_name}:${wallix-bastion_device_service.ssh.service_name}"]
  # The Bastion signs the SSH key of the account with the CA of the domain, for this long.
  certificate_validity = var.certificate_validity
}

# SSH key of the account, generated by the Bastion: this is the key the certificates are issued for.
resource "wallix-bastion_domain_account_credential" "admin" {
  domain_id   = wallix-bastion_domain_account.admin.domain_id
  account_id  = wallix-bastion_domain_account.admin.id
  type        = "ssh_key"
  private_key = "generate:ED25519"
}

resource "wallix-bastion_device" "server" {
  device_name = "${local.name}-srv01"
  host        = var.target_host
  description = "Automation Showroom: SSH server trusting the CA of the domain"
}

resource "wallix-bastion_device_service" "ssh" {
  device_id         = wallix-bastion_device.server.id
  service_name      = "SSH"
  protocol          = "SSH"
  port              = 22
  connection_policy = "SSH"
  subprotocols      = ["SSH_SHELL_SESSION"]
  global_domains    = [wallix-bastion_domain.ssh_ca.domain_name]
}
