bastion_info_ip   = "bastion.example.com"
bastion_info_user = "admin"

# Keep secrets out of this file: export TF_VAR_bastion_info_token="<API key>"
# (or TF_VAR_bastion_info_password) before running Terraform.

# Lab Bastion with a self-signed certificate only:
# bastion_info_insecure_skip_verify = true

banner_enabled = true
banner_message = "Scheduled maintenance on Sunday from 02:00 to 04:00 UTC."
